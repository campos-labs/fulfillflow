# Copy only for a synthetic smoke or an approved host-specific campaign.
# This file intentionally contains no official baseline values and no usable secrets.
# The runner injects its authenticated manifest, load name, phase, and output paths.

# Isolated PostgreSQL identity and application DSN. Keep credentials outside Git.
BENCH_POSTGRES_DB=
BENCH_POSTGRES_USER=
BENCH_POSTGRES_PASSWORD=
BENCH_DATABASE_URL=

# Benchmark-only runtime secrets; never commit functional values.
SESSION_SECRET=
CARRIER_ALPHA_WEBHOOK_SECRET=
CARRIER_BETA_WEBHOOK_SECRET=

# Host-specific Compose limits remain deliberately unset until campaign approval.
BENCH_APP_CPUS=
BENCH_APP_MEMORY=
BENCH_POSTGRES_CPUS=
BENCH_POSTGRES_MEMORY=
BENCH_LOADGEN_CPUS=
BENCH_LOADGEN_MEMORY=

# Pool and runtime settings must match the future approved campaign manifest.
BENCH_DB_POOL_SIZE=
BENCH_DB_MAX_OVERFLOW=
BENCH_DB_POOL_TIMEOUT_SECONDS=
BENCH_DB_STATEMENT_TIMEOUT_MS=

# These values are compared with the future approved campaign manifest.
BENCH_LOG_LEVEL=WARNING
BENCH_LOG_FORMAT=json
BENCH_OTEL_ENABLED=false
BENCH_OTEL_TRACES_SAMPLER_ARG=0.0
