# Copy to .env only after replacing every required secret placeholder.
# Keep each role password and its percent-encoded DSN password aligned.
# These settings initialize only a fresh v1.2 Compose volume.
APP_ENV=local
APP_NAME=FulfillFlow
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=America/Sao_Paulo

POSTGRES_PASSWORD=replace-me-with-a-local-admin-password
CORE_DB_PASSWORD=replace-me-with-a-local-core-password
TRACKING_DB_PASSWORD=replace-me-with-a-local-tracking-password
CORE_DATABASE_URL=postgresql+psycopg://fulfillflow_core:replace-me-with-a-local-core-password@db:5432/fulfillflow_core
TRACKING_DATABASE_URL=postgresql+psycopg://fulfillflow_tracking:replace-me-with-a-local-tracking-password@db:5432/fulfillflow_tracking
# When running a process directly, set DATABASE_URL to its owner DSN and SERVICE_ROLE.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000

LOG_LEVEL=INFO
LOG_FORMAT=json

INTERNAL_API_SECRET=replace-me-with-at-least-32-random-characters
SERVICE_HTTP_TIMEOUT_SECONDS=10
FORWARDING_TIMEOUT_SECONDS=30
SESSION_SECRET=replace-me-with-at-least-32-random-characters
CARRIER_ALPHA_WEBHOOK_SECRET=replace-me-with-a-distinct-alpha-secret
CARRIER_BETA_WEBHOOK_SECRET=replace-me-with-a-distinct-beta-secret
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
MAX_WEBHOOK_BODY_BYTES=65536

METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=fulfillflow
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

SEED_RANDOM_SEED=20260828

# Workers use owner-scoped AMQP credentials from infrastructure/rabbitmq-v12.json.
# When overriding CORE_AMQP_URL or TRACKING_AMQP_URL, provision matching broker users.
# Host worker processes require AMQP_URL; APIs do not.

# Preserve the existing RabbitMQ hostname when reusing a v1.2 volume (see README).
# Fresh projects use the stable default below.
# RABBITMQ_HOSTNAME=broker
