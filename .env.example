# Copy to .env only after replacing every required secret placeholder.
# If the PostgreSQL password changes, keep POSTGRES_PASSWORD and DATABASE_URL aligned.
# Percent-encode reserved URL characters in DATABASE_URL credentials.
APP_ENV=local
APP_NAME=FulfillFlow
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=America/Sao_Paulo

POSTGRES_DB=fulfillflow
POSTGRES_USER=fulfillflow
POSTGRES_PASSWORD=replace-me-with-a-local-database-password
DATABASE_URL=postgresql+psycopg://fulfillflow:replace-me-with-a-local-database-password@db:5432/fulfillflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000

LOG_LEVEL=INFO
LOG_FORMAT=json

SESSION_SECRET=replace-me-with-at-least-32-random-characters
CARRIER_ALPHA_WEBHOOK_SECRET=replace-me-with-a-distinct-alpha-secret
CARRIER_BETA_WEBHOOK_SECRET=replace-me-with-a-distinct-beta-secret
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
MAX_WEBHOOK_BODY_BYTES=65536

METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=fulfillflow
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

SEED_RANDOM_SEED=20260828
